# ==========================================
# ReelDigest Configuration (.env)
# ==========================================

# Omniroute (or OpenAI/Groq) Settings
# Example: If using Omniroute or a local OpenAI-compatible endpoint like vLLM/Ollama
# OMNIROUTE_BASE_URL=http://localhost:8000/v1
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=your_api_key_here
OMNIROUTE_MODEL=llama-3.1-8b-instruct

# Transcriber Settings
# Model sizes: tiny.en, base.en, small.en, medium.en
WHISPER_MODEL_SIZE=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4

# Downloader Settings
# Explicit location to ffmpeg (leave blank to auto-detect from PATH or WinGet)
FFMPEG_PATH=
# Optional: browser to grab cookies from to bypass Instagram arbitrary limits (e.g. chrome, firefox)
BROWSER_COOKIES=

# File Output
OUTPUT_DIR=output
